{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@spotify-effect/core": ["../spotify-effect/src/index.ts"],
      "@spotify-effect/browser": ["../browser/src/index.ts"],
      "@spotify-effect/otel-node": ["../otel-node/src/index.ts"]
    }
  },
  "include": [
    "../spotify-effect/src/**/*.ts",
    "../browser/src/**/*.ts",
    "../otel-node/src/**/*.ts"
  ],
  "exclude": [
    "../spotify-effect/src/**/*.test.ts",
    "../browser/src/**/*.test.ts",
    "../otel-node/src/**/*.test.ts"
  ]
}
