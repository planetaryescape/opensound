{
  "name": "@spotify-effect/browser",
  "version": "0.7.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planetaryescape/opensound.git",
    "directory": "packages/browser"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && bun vitest run",
    "test:watch": "bun vitest",
    "build": "tsup src/index.ts --format cjs,esm --dts"
  },
  "dependencies": {
    "@spotify-effect/core": "^0.7.0"
  },
  "devDependencies": {
    "effect": "4.1.4"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  }
}
